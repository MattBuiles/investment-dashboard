# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: only for the scheduled sync cron. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Bearer secret validated by /api/cron/sync-ibkr. Must be plain ASCII.
CRON_SECRET=

# Optional cross-app links
NEXT_PUBLIC_MARKET_AGENT_URL=
NEXT_PUBLIC_SPLITSTREAM_URL=

# Owner-only integrations (leave empty to disable)
OWNER_EMAIL=
NOTION_TOKEN=
NOTION_PATRIMONIO_DS=
NOTION_INVERSIONES_DS=

# Resend — sends the in-app feedback form.
# Generate the API key at https://resend.com/api-keys
RESEND_API_KEY=

# Destination inbox for in-app feedback. The email's `replyTo` is the
# authenticated user's address so replies reach the customer.
FEEDBACK_INBOX=feedback@example.com

# Resend "From" header. Defaults to Resend's test sender in dev; in production
# set it to your verified domain, e.g. "Investment Dashboard <feedback@yourapp.com>"
FEEDBACK_FROM_ADDRESS=

# Upstash Redis — rate limiter for the feedback endpoint.
# 5 submissions per day per authenticated user. In dev, missing values are no-ops.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
